FROM pytorch/pytorch:2.13.0-cuda13.0-cudnn9-runtime

ARG APP_VERSION=0.6.0
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    APP_VERSION=${APP_VERSION} \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video \
    YOLO_CONFIG_DIR=/config/ultralytics

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg curl gosu passwd \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --non-unique --gid 1000 analyzer \
    && useradd --non-unique --uid 1000 --gid analyzer --create-home analyzer

WORKDIR /opt/veo-analyzer
COPY pyproject.toml ./
COPY app ./app
RUN python -m pip install --break-system-packages '.[training]'

RUN mkdir -p /opt/models \
    && python -c "from pathlib import Path; from ultralytics import YOLO; [Path(name).replace(Path('/opt/models') / name) for name in ('yolo11n.pt','yolo11s.pt','yolo11m.pt') if not (YOLO(name) is None)]"

RUN mkdir -p /config /exports \
    && chown -R analyzer:analyzer /opt/veo-analyzer /config /exports

COPY docker/entrypoint.sh /usr/local/bin/veo-analyzer-entrypoint
RUN chmod 0755 /usr/local/bin/veo-analyzer-entrypoint

EXPOSE 8080
VOLUME ["/config", "/exports"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD curl -fsS http://127.0.0.1:8080/health || exit 1
ENTRYPOINT ["/usr/local/bin/veo-analyzer-entrypoint"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers", "--forwarded-allow-ips", "127.0.0.1"]
